NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/bugtracker
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379
CACHE_TTL_DASHBOARD_SECONDS=45
CACHE_TTL_TASKS_SECONDS=20
CACHE_TTL_BUGS_SECONDS=20
CACHE_TTL_TRIAGE_SECONDS=30
CACHE_TTL_PROJECTS_SECONDS=300
CACHE_TTL_EPICS_SECONDS=180
CACHE_TTL_SPRINTS_SECONDS=45
CACHE_TTL_NOTIFICATIONS_SECONDS=15
CACHE_LOGGING_ENABLED=false
CACHE_REDIS_TIMEOUT_MS=250
ADMIN_DEFAULT_PASSWORD=admin123
ENABLE_ADMIN_DEFAULT_LOGIN=true
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-password
EMAIL_SECURE=true
EMAIL_FROM=Pirnav Support <your-email@example.com>
APP_URL=https://curecode.site
FRONTEND_URL=https://curecode.site,https://www.curecode.site
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

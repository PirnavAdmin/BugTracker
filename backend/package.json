{
  "name": "jira-clone-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express and MongoDB backend for the Jira-like project management app",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.test.js",
    "seed": "node scripts/seed.js",
    "reset:default-user": "node scripts/resetDefaultUser.js",
    "reset:platform-admin": "node scripts/resetPlatformAdmin.js",
    "migrate:legacy-tenant": "node scripts/migrateLegacyTenantIdentity.js",
    "backup:export": "node scripts/exportMongoBackup.js",
    "reconcile:storage": "node scripts/reconcileStorage.js",
    "migrate:storage": "node scripts/migrateStorageBackfill.js",
    "indexes:performance:local": "node scripts/createLocalPerformanceIndexes.js --apply",
    "db:target:check": "node scripts/inspectMongoTarget.js",
    "indexes:issues:inspect:local": "node scripts/inspectLocalIssueIndexes.js",
    "queries:issues:explain:local": "node scripts/explainLocalIssueQueries.js",
    "start": "node server.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1068.0",
    "bcrypt": "^6.0.0",
    "cashfree-pg": "^6.0.5",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "uuid": "11.1.1",
    "unzipper": "0.12.5"
  }
}
